{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push origin main)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push origin *:main:*)",
      "Bash(git push origin *:main)",
      "Bash(git push origin *:refs/heads/main:*)",
      "Bash(git push origin *:refs/heads/main)",
      "Bash(git push --force origin main:*)",
      "Bash(git push --force origin HEAD:main:*)",
      "Bash(git push -f origin main:*)",
      "Bash(git push -f origin HEAD:main:*)",
      "Bash(git push --force-with-lease origin main:*)",
      "Bash(git push --force-with-lease origin HEAD:main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push --set-upstream origin main:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git push * --no-verify:*)",
      "Bash(git push * --no-verify)",
      "PowerShell(git push origin main:*)",
      "PowerShell(git push origin main)",
      "PowerShell(git push origin HEAD:main:*)",
      "PowerShell(git push origin HEAD:main)",
      "PowerShell(git push origin *:main:*)",
      "PowerShell(git push origin *:main)",
      "PowerShell(git push origin *:refs/heads/main:*)",
      "PowerShell(git push origin *:refs/heads/main)",
      "PowerShell(git push --force origin main:*)",
      "PowerShell(git push --force origin HEAD:main:*)",
      "PowerShell(git push -f origin main:*)",
      "PowerShell(git push -f origin HEAD:main:*)",
      "PowerShell(git push --force-with-lease origin main:*)",
      "PowerShell(git push --force-with-lease origin HEAD:main:*)",
      "PowerShell(git push -u origin main:*)",
      "PowerShell(git push --set-upstream origin main:*)",
      "PowerShell(git push --no-verify:*)",
      "PowerShell(git push * --no-verify:*)",
      "PowerShell(git push * --no-verify)"
    ],
    "ask": [
      "Bash(*--confirmed*)",
      "Bash(*confirmed=true*)",
      "Bash(*project-down*)",
      "Bash(*confirmation=*)",
      "PowerShell(*--confirmed*)",
      "PowerShell(*confirmed=true*)",
      "PowerShell(*project-down*)",
      "PowerShell(*confirmation=*)"
    ]
  }
}
